/* Shared highlight.js syntax theme (Tokyo Night palette) for every code
   surface — post bodies (.markdown-content) and comment bodies
   (.comment-body). The code surface is a fixed dark #1a1b26 background
   regardless of color mode, so a single theme applies in both light and dark
   mode. Selectors are global because the .hljs-* token classes only appear on
   code that highlight.js has tokenized. (DEC-090, TASK-157)
*/

.hljs-comment,
.hljs-quote {
	color: #565f89;
	font-style: italic;
}

.hljs-keyword,
.hljs-selector-tag,
.hljs-literal,
.hljs-doctag {
	color: #bb9af7;
}

.hljs-string,
.hljs-regexp,
.hljs-addition {
	color: #9ece6a;
}

.hljs-number,
.hljs-symbol,
.hljs-bullet,
.hljs-meta {
	color: #ff9e64;
}

.hljs-title,
.hljs-section,
.hljs-title.function_ {
	color: #7aa2f7;
}

.hljs-title.class_,
.hljs-type,
.hljs-built_in {
	color: #2ac3de;
}

.hljs-variable,
.hljs-template-variable,
.hljs-attr {
	color: #c0caf5;
}

.hljs-operator,
.hljs-params {
	color: #89ddff;
}

.hljs-tag,
.hljs-name {
	color: #f7768e;
}

.hljs-punctuation {
	color: #565f89;
}

.hljs-emphasis {
	font-style: italic;
}

.hljs-strong {
	font-weight: bold;
}
