{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parser": "vue-eslint-parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "parser": "@typescript-eslint/parser"
  },
  "extends": [
    "eslint:recommended",
    "plugin:vue/vue3-recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "plugins": ["vue", "@typescript-eslint"],
  "rules": {
    "vue/multi-word-component-names": "off",
    "vue/no-v-html": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "vue/max-attributes-per-line": "off",
    "vue/attributes-order": "off",
    "vue/singleline-html-element-content-newline": "off",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "vue/no-unused-vars": "error",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-empty-function": "off"
  },
  "globals": {
    "ref": "readonly",
    "reactive": "readonly",
    "computed": "readonly",
    "watch": "readonly",
    "watchEffect": "readonly",
    "onMounted": "readonly",
    "onUnmounted": "readonly",
    "onBeforeMount": "readonly",
    "onBeforeUnmount": "readonly",
    "getCurrentInstance": "readonly",
    "inject": "readonly",
    "provide": "readonly",
    "toRefs": "readonly",
    "toRef": "readonly",
    "nextTick": "readonly",
    "useHead": "readonly",
    "useRoute": "readonly",
    "useRouter": "readonly",
    "navigateTo": "readonly",
    "useAsyncData": "readonly",
    "useFetch": "readonly",
    "usePosts": "readonly",
    "usePopularPosts": "readonly",
    "usePost": "readonly",
    "useRelatedPosts": "readonly",
    "usePostView": "readonly",
    "usePostLike": "readonly",
    "useTags": "readonly",
    "useSearch": "readonly",
    "fetchAdminCategories": "readonly",
    "fetchAdminTags": "readonly",
    "fetchAdminPost": "readonly",
    "createAdminPost": "readonly",
    "updateAdminPost": "readonly",
    "useCookie": "readonly",
    "useRequestHeaders": "readonly",
    "useState": "readonly",
    "useNuxtApp": "readonly",
    "definePageMeta": "readonly",
    "defineComponent": "readonly",
    "defineNuxtConfig": "readonly",
    "defineEventHandler": "readonly",
    "readBody": "readonly",
    "sendError": "readonly",
    "createError": "readonly",
    "$fetch": "readonly",
    "useStorage": "readonly",
    "useRuntimeConfig": "readonly",
    "string": "readonly",
    "number": "readonly",
    "boolean": "readonly",
    "null": "readonly",
    "undefined": "readonly",
    "unknown": "readonly",
    "any": "readonly",
    "void": "readonly",
    "never": "readonly",
    "object": "readonly",
    "Array": "readonly",
    "Record": "readonly",
    "Partial": "readonly",
    "Pick": "readonly",
    "Omit": "readonly",
    "Exclude": "readonly",
    "Extract": "readonly",
    "NonNullable": "readonly",
    "Promise": "readonly"
  },
  "ignorePatterns": [
    ".nuxt/",
    ".output/",
    "node_modules/",
    "coverage/",
    "*.config.js",
    "*.config.ts",
    "*.config.mjs",
    "*.config.mts",
    "nuxt.config.ts",
    "e2e/**",
    "tests/**"
  ]
}
