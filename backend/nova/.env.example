# Backend Environment Variables
# 复制此文件为 .env 并填入实际值

# ===================
# 必需配置
# ===================

# JWT 密钥 - 生产环境请使用复杂的随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# ===================
# 可选配置
# ===================

# 数据库 URL (默认使用 SQLite)
# SQLite (开发环境 / 测试):
# DATABASE_URL=sqlite:///./x-blog.db
# PostgreSQL (生产环境 / Docker Compose):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS 允许的源 (前端地址)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:13333,https://your-domain.com

# 管理员初始密码 (用于 init_admin.py 创建默认管理员)
# 生产环境请设置强密码，不要使用默认值
# ADMIN_PASSWORD=change-me-in-production

# ===================
# Web Push 通知 (可选)
# ===================
# 读者浏览器推送订阅 (DEC-055)。生成一次 ES256 (P-256) VAPID 密钥对 (base64url):
#   uv run python -c "import base64; from cryptography.hazmat.primitives.asymmetric import ec; k=ec.generate_private_key(ec.SECP256R1()); p=k.public_key().public_numbers(); print('VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(b'\x04'+p.x.to_bytes(32,'big')+p.y.to_bytes(32,'big')).rstrip(b'=').decode()); print('VAPID_PRIVATE_KEY='+base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32,'big')).rstrip(b'=').decode())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ===================
# 监控配置 (可选)
# ===================

# Sentry DSN - 用于后端错误追踪和性能监控
# 从 Sentry 项目设置中获取 (Settings > Projects > [Project] > Client Keys)
# 设置后自动启用错误上报，采样率 10%
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===================
# 使用说明
# ===================
#
# 1. 复制 .env.example 为 .env:
#    cp .env.example .env
#
# 2. 填入上述配置项
#
# 3. 启动应用:
#    uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 18888
